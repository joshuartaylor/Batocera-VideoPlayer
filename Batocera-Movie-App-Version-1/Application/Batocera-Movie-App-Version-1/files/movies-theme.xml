<?xml version="1.0" encoding="UTF-8"?>
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>
  <include>__CARBON_THEME__</include>

  <!-- Main carousel: replace Carbon's actual background element at z10 and
       disable every real random-preview element by its exact Carbon name.
       Carbon's carousel (z20/40), text, blue help icons and bars stay intact. -->
  <view name="system">
    <image name="background" extra="static"><path>./movies-theater-background.png</path><visible>true</visible><pos>0 0</pos><origin>0 0</origin><size>1 1</size><color>FFFFFFFF</color><zIndex>10</zIndex></image>
    <image name="backgroundMachines" extra="true"><visible>false</visible></image>
    <image name="backgroundFade" extra="static"><visible>false</visible></image>
    <video name="backgroundvideo" extra="true"><visible>false</visible></video>
    <image name="randomImage" extra="true"><visible>false</visible></image>
    <image name="box" extra="true"><visible>false</visible></image>
    <video name="videobox" extra="true"><visible>false</visible></video>
    <image name="ControllerOverlay" extra="true"><visible>false</visible></image>
    <image name="logo"><path>./movies-logo.png</path><linearSmooth>true</linearSmooth></image>
  </view>

  <!-- Inside Movies: force Carbon's detailed view, then restore the theater
       background, left list panel, right poster panel and gold poster frame. -->
  <view name="detailed">
    <image name="background"><path>./movies-theater-background.png</path><visible>true</visible><pos>0 0</pos><origin>0 0</origin><size>1 1</size><color>FFFFFFFF</color><zIndex>10</zIndex></image>
    <image name="consolebk" extra="true"><visible>false</visible></image>
    <image name="ControllerOverlay" extra="true"><visible>false</visible></image>
    <image name="detailsBk" extra="true"><visible>false</visible></image>
    <image name="detailsBkLine" extra="true"><visible>false</visible></image>
    <image name="e_list_panel" extra="true"><path>./movies-panel.svg</path><pos>0.025 0.205</pos><size>0.445 0.735</size><zIndex>20</zIndex></image>
    <image name="e_art_panel" extra="true"><path>./movies-panel.svg</path><pos>0.485 0.205</pos><size>0.49 0.735</size><zIndex>20</zIndex></image>
    <image name="logo"><path>./movies-logo.png</path><pos>0.5 0.074</pos><origin>0.5 0.5</origin><maxSize>0.26 0.11</maxSize><linearSmooth>true</linearSmooth><zIndex>100</zIndex></image>
    <textlist name="gamelist">
      <pos>0.048 0.235</pos><size>0.398 0.67</size><alignment>left</alignment><horizontalMargin>0.018</horizontalMargin><fontSize>0.034</fontSize>
      <primaryColor>FFFFFFFF</primaryColor><secondaryColor>FFF1B8FF</secondaryColor><selectedColor>140000FF</selectedColor>
      <selectorColor>FFD447FF</selectorColor><selectorColorEnd>FF8A24FF</selectorColorEnd><selectorHeight>0.057</selectorHeight><zIndex>25</zIndex>
    </textlist>
    <!-- Carbon displays game image metadata through md_video's snapshot mode. -->
    <video name="md_video"><visible>true</visible><pos>0.735 0.475</pos><origin>0.5 0.5</origin><maxSize>0.255 0.480</maxSize><showSnapshotNoVideo>true</showSnapshotNoVideo><showSnapshotDelay>true</showSnapshotDelay><zIndex>29</zIndex></video>
    <image name="md_image"><visible>true</visible><pos>0.735 0.475</pos><origin>0.5 0.5</origin><maxSize>0.255 0.480</maxSize><zIndex>30</zIndex></image>
    <image name="e_poster_frame" extra="true"><path>./movie-poster-frame.png</path><pos>0.735 0.475</pos><origin>0.5 0.5</origin><maxSize>0.320 0.570</maxSize><zIndex>31</zIndex></image>
    <text name="md_name"><pos>0.515 0.770</pos><size>0.44 0.040</size><fontSize>0.025</fontSize><color>FFD447FF</color><alignment>center</alignment><zIndex>32</zIndex></text>
    <!-- Do not display Batocera's UNKNOWN placeholders when optional movie
         metadata is unavailable. The useful title and description remain. -->
    <datetime name="md_releasedate"><visible>false</visible></datetime>
    <text name="md_genre"><visible>false</visible></text>
    <text name="md_playcount"><visible>false</visible></text>
    <text name="md_description"><pos>0.525 0.845</pos><size>0.41 0.075</size><fontSize>0.015</fontSize><zIndex>32</zIndex></text>
  </view>

  <!-- Carbon remembers one of these grid-based views globally.  Re-declaring
       only its inheritance is not enough because Carbon registered the view
       first.  Build the Movies presentation inside the existing grid renderer
       instead.  This intentionally does not declare a helpsystem: Carbon keeps
       complete ownership of the bottom text, icons, font and spacing. -->
  <customView name="Icons,Tiles,Carousel,Boxes,Content" inherits="grid" displayName="Movies">
    <image name="e_movies_background" extra="true"><path>./movies-theater-background.png</path><pos>0 0</pos><origin>0 0</origin><size>1 0.94</size><zIndex>800</zIndex></image>
    <image name="e_movies_list_panel" extra="true"><path>./movies-panel.svg</path><pos>0.025 0.205</pos><size>0.445 0.735</size><zIndex>810</zIndex></image>
    <image name="e_movies_art_panel" extra="true"><path>./movies-panel.svg</path><pos>0.485 0.205</pos><size>0.49 0.735</size><zIndex>810</zIndex></image>
    <image name="e_movies_logo" extra="true"><path>./movies-logo.png</path><pos>0.5 0.074</pos><origin>0.5 0.5</origin><maxSize>0.26 0.11</maxSize><linearSmooth>true</linearSmooth><zIndex>820</zIndex></image>

    <!-- One-column grid behaves as the large, highlighted movie-title list. -->
    <imagegrid name="gamegrid">
      <pos>0.048 0.235</pos><size>0.398 0.67</size><autoLayout>1 9</autoLayout><margin>0.004 0.008</margin><zIndex>830</zIndex>
      <itemTemplate>
        <container name="movieRow">
          <pos>0 0</pos><size>1 1</size>
          <image name="movieRowBackground">
            <path>./movies-panel.svg</path><pos>0 0</pos><origin>0 0</origin><size>1 1</size><opacity>0.18</opacity><color>4B2380FF</color><zIndex>1</zIndex>
            <storyboard event="activate"><animation property="opacity" to="1" duration="100"/><animation property="color" to="FFD447FF" duration="100"/></storyboard>
            <storyboard event="deactivate"><animation property="opacity" to="0.18" duration="100"/><animation property="color" to="4B2380FF" duration="100"/></storyboard>
          </image>
          <text name="movieRowTitle">
            <text>{game:name}</text><pos>0.035 0</pos><size>0.93 1</size><verticalAlignment>center</verticalAlignment><alignment>left</alignment><fontSize>0.036</fontSize><color>FFFFFFFF</color><multiLine>false</multiLine><zIndex>2</zIndex>
            <storyboard event="activate"><animation property="color" to="140000FF" duration="100"/></storyboard>
            <storyboard event="deactivate"><animation property="color" to="FFFFFFFF" duration="100"/></storyboard>
          </text>
        </container>
      </itemTemplate>
    </imagegrid>

    <!-- Selected-game bindings provide the poster and information even though
         the active Carbon renderer is technically a custom grid view. -->
    <image name="e_movies_selected_poster" extra="true"><path>{game:image}</path><visible>exists({game:image})</visible><pos>0.735 0.475</pos><origin>0.5 0.5</origin><maxSize>0.255 0.480</maxSize><linearSmooth>true</linearSmooth><zIndex>840</zIndex></image>
    <image name="e_movies_poster_frame" extra="true"><path>./movie-poster-frame.png</path><pos>0.735 0.475</pos><origin>0.5 0.5</origin><maxSize>0.320 0.570</maxSize><zIndex>841</zIndex></image>
    <text name="e_movies_title" extra="true"><text>{game:name}</text><pos>0.515 0.770</pos><size>0.44 0.040</size><fontSize>0.025</fontSize><color>FFD447FF</color><alignment>center</alignment><zIndex>842</zIndex></text>
    <text name="e_movies_facts" extra="true"><visible>false</visible></text>
    <text name="e_movies_description" extra="true"><text>{game:desc}</text><pos>0.525 0.845</pos><size>0.41 0.075</size><fontSize>0.015</fontSize><color>FFFFFFFF</color><multiLine>true</multiLine><zIndex>842</zIndex></text>
  </customView>
</theme>
